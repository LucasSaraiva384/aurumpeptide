# Copie para `.env.local` (nesta pasta, apps/site/) e preencha com valores
# reais. Ver .env.example na raiz do repositório para o passo a passo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp da Aurum Peptide para o CTA "Comprar no WhatsApp",
# formato internacional sem símbolos (ex.: 5511999999999). Placeholder —
# preencher com o número real.
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# URL pública do site, sem barra final — usada para montar URLs absolutas
# (canonical, sitemap.xml, robots.txt, JSON-LD, Open Graph). Sem esta
# variável, o fallback é https://aurumpeptide.com.br.
# NEXT_PUBLIC_SITE_URL=https://aurumpeptide.com.br

# Google Analytics 4 (Measurement ID, formato G-XXXXXXXXXX). Sem esta
# variável, nenhum script de GA4 é carregado.
# NEXT_PUBLIC_GA_ID=

# Google Tag Manager (Container ID, formato GTM-XXXXXXX). Sem esta
# variável, nenhum script de GTM é carregado.
# NEXT_PUBLIC_GTM_ID=

# Código de verificação do Google Search Console (meta tag
# google-site-verification). Sem esta variável, a tag não é renderizada.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# WhatsApp Business Cloud API (recepção automática de mensagens, ver
# apps/site/app/api/whatsapp/webhook). Mesmos valores usados por
# scripts/meta_graph.py na raiz do repo — copiar de lá, nunca duplicar
# manualmente. server-only, sem prefixo NEXT_PUBLIC_.
META_ACCESS_TOKEN=
META_API_VERSION=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token arbitrário (gerado localmente) usado no handshake de verificação do
# webhook — precisa ser o mesmo valor configurado no painel da Meta ao
# registrar a URL do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Chave service_role do Supabase (Project Settings > API). Bypassa RLS —
# usada só pelo webhook do WhatsApp (apps/site/lib/supabaseAdmin.ts) pra
# escrever em whatsapp_contatos/whatsapp_mensagens. server-only, nunca expor
# com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL do webhook do Chatwoot self-hosted pra onde o webhook do WhatsApp
# espelha cada mensagem recebida (alimenta a inbox de monitoramento/resposta
# manual). server-only.
CHATWOOT_WHATSAPP_WEBHOOK_URL=

# API do Chatwoot (self-hosted) — usada só pra registrar, como nota privada
# na conversa, a confirmação de que a automação de boas-vindas enviou cada
# mensagem (não dispara reenvio real ao cliente: sempre private:true). Token
# em Chatwoot > Profile Settings > Access Token. server-only.
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# Segredo compartilhado (gerado localmente) que autentica o webhook de saída
# do Chatwoot (evento "message_created") em apps/site/app/api/chatwoot/webhook
# — precisa ser o mesmo valor colocado na query string ?secret= da URL
# cadastrada em Chatwoot > Configurações > Integrações > Webhooks. Esse é hoje
# o caminho real de recepção de mensagens (a Meta entrega direto pro
# Chatwoot, não pro webhook antigo). server-only.
CHATWOOT_OUTGOING_WEBHOOK_SECRET=

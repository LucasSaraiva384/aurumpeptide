# Copie para `.env.local` (nesta pasta, apps/admin/) e preencha com valores
# reais. Ver .env.example na raiz do repositório para o passo a passo.
#
# O admin usa só a chave anon (com sessão autenticada) — RLS libera o
# acesso conforme docs/plataforma/arquitetura.md. Não usar service_role aqui.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

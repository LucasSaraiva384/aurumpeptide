{
  "name": "aurum-plataforma",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:site": "pnpm --filter site dev",
    "dev:admin": "pnpm --filter admin dev",

# Copie este arquivo para `.env` (na raiz do projeto) e preencha com valores reais.
# `.env` está no .gitignore — nunca commitar credenciais reais.
# Ver docs/integracoes/meta.md para o passo a passo de como obter cada valor.

# Token de acesso do System User do Business Manager (permanente, não expira
# enquanto não for revogado). Escopos necessários: ads_management, ads_read,
# business_management, instagram_basic, instagram_content_publish,
# instagram_manage_insights, instagram_manage_comments, pages_show_list,
# pages_read_engagement, pages_manage_posts, pages_manage_metadata.
META_ACCESS_TOKEN=

# Versão da Graph API a usar. Confira a versão estável mais recente em
# https://developers.facebook.com/docs/graph-api/changelog antes de definir.
META_API_VERSION=v21.0

# Chave secreta do App (Configurações do app > Básico > Chave Secreta do
# Aplicativo). Usada para validar a assinatura X-Hub-Signature-256 das
# requisições recebidas no webhook do WhatsApp.
META_APP_SECRET=

# ID do número de telefone do WhatsApp Business (WhatsApp Manager > Números
# de telefone > Identificação do número). Usado para enviar mensagens via
# POST /{numero-id}/messages.
META_WHATSAPP_PHONE_NUMBER_ID=

# ID da conta do WhatsApp Business (WABA) vinculada ao número acima.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token arbitrário (gerado localmente, não vem da Meta) usado no handshake
# de verificação do webhook (GET com hub.verify_token) — precisa ser o mesmo
# valor configurado no painel da Meta ao registrar a URL do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ID da conta de anúncios (Ads Manager > Configurações da conta), sem o prefixo "act_".
META_AD_ACCOUNT_ID=

# ID da página do Facebook da Aurum Peptide.
META_PAGE_ID=

# ID da conta Business do Instagram vinculada à página acima.
META_IG_BUSINESS_ACCOUNT_ID=

# ID do Business Manager (Configurações do Business > informações do negócio).
META_BUSINESS_ID=

# Chave de API da OpenAI, usada por scripts/openai_image.py (geração de imagem via ChatGPT/gpt-image).
# Gerar em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Chave de API do Google AI (Gemini), usada por scripts/gemini_image.py.
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Chave de API da Gamma (geração de documentos/apresentações), usada por
# scripts/gamma_generate.py. Requer plano Pro/Ultra/Teams/Business.
# Gerar em https://gamma.app/settings/api-keys
GAMMA_API_KEY=

# ID do tema customizado "Aurum Peptide" (verde profundo + dourado). Usado
# por padrão em scripts/gamma_generate.py se definido. Confirmar/gerar via
# GET /themes ou em gamma.app/settings/design.
GAMMA_THEME_ID=

# Supabase (banco de dados da plataforma catálogo + admin — ver
# docs/plataforma/arquitetura.md). Valores em Project Settings > API.
# NEXT_PUBLIC_* são expostas ao navegador de propósito: a chave anon
# só permite o que as policies de RLS liberarem (produtos ativos, leitura).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — acesso total, ignora RLS. NUNCA expor ao
# navegador nem usar com o prefixo NEXT_PUBLIC_. Uso restrito a
# scripts/servidor administrativos, se algum dia for necessário.
SUPABASE_SERVICE_ROLE_KEY=
